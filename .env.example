# Give this experiment its own prefix so it cannot replace another celld deployment.
CELLD_BUCKET=gs://YOUR_BUCKET/cloudflare-os-dev

# Required for GCS when the machine has no attached GCP service account.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json

# Optional overrides:
# CELLD_LISTEN_ADDR=127.0.0.1:8790
# CELLD_URL=http://127.0.0.1:8790

# Enables celld's experimental implementation of the Worker Loader binding.
CELLD_WORKER_LOADER=LOADER
